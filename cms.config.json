{
  "media": {
    "input": "public/uploads",
    "output": "/uploads"
  },
  "collections": [
    {
      "name": "blogs",
      "label": "Blogs",
      "path": "src/content/blogs",
      "format": "md",
      "fields": [
        {
          "name": "title",
          "label": "Tiêu đề",
          "type": "string",
          "required": true
        },
        {
          "name": "description",
          "label": "Mô tả SEO",
          "type": "text"
        },
        {
          "name": "pubDate",
          "label": "Ngày đăng",
          "type": "date"
        },
        {
          "name": "image",
          "label": "Ảnh đại diện",
          "type": "image"
        },
        {
          "name": "draft",
          "label": "Bản nháp",
          "type": "boolean"
        },
        {
          "name": "body",
          "label": "Nội dung",
          "type": "markdown"
        }
      ]
    }
  ]
}
